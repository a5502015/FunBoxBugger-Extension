{
  "manifest_version": 3,
  "name": "陀螺蹲點者 - FunBox 庫存監測",
  "version": "1.0.2",
  "version_name": "V1.0.2b",
  "description": "自動監測 FunBox 商品庫存，有貨時立即桌面通知。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "陀螺蹲點者"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://shop.funbox.com.tw/*"
  ]
}
